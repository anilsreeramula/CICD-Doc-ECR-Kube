<!DOCTYPE html>
<html>
<head>
    <title>Movies</title>
</head>
<body>
    <h1>Top 10 Movies</h1>

    <% movies.forEach(movie => { %>
        <div style="border:1px solid #ccc; padding:10px; margin:10px;">
            <h2><%= movie.title %></h2>
            <p>Year: <%= movie.year %></p>
            <p>Rating: <%= movie.rating %></p>
        </div>
    <% }) %>

</body>
</html>
